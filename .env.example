# Copie ce fichier en .env puis remplace les deux valeurs par celles de TON projet Supabase
# (Supabase > Project Settings > API, ou bouton « Connect » en haut du tableau de bord).
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx"

# O1 « Proposer un brouillon » : adresse du scénario Make (Webhooks > Custom webhook).
# Valeur secrète : à mettre uniquement dans ton fichier .env (ignoré par Git) et dans les variables de l'hébergeur.
MAKE_WEBHOOK_URL=""
